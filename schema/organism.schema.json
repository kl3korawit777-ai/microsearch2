{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "organism.schema.json",
  "title": "organism: หนึ่งชนิดใน data/organisms/<group>.json",
  "description": "ส่วนที่ขึ้นกับ groups.json (ค่าใน traits, tags, ลำดับขั้นใน lineage) ตรวจใน scripts/microsearch.py ไม่ได้อยู่ใน schema นี้",
  "type": "object",
  "required": [
    "id", "group", "scientific_name", "name_th", "name_en", "reading_th",
    "lineage", "level", "tags", "summary_th", "summary_en",
    "traits", "traits_text_th", "traits_text_en", "images", "review", "taxon_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 1 },
    "group": { "type": "string", "minLength": 1 },
    "scientific_name": { "type": "string", "minLength": 1 },
    "name_th": { "type": "string" },
    "name_en": { "type": "string" },
    "reading_th": { "type": "string" },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lineage_item" }
    },
    "level": { "type": "string", "enum": ["hs", "uni"] },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "summary_th": { "type": "string" },
    "summary_en": { "type": "string" },
    "traits": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "traits_text_th": { "type": "object", "additionalProperties": { "type": "string" } },
    "traits_text_en": { "type": "object", "additionalProperties": { "type": "string" } },
    "illustration": { "type": "string" },
    "extra_th": { "type": "object" },
    "extra_en": { "type": "object" },
    "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
    "review": { "type": "string", "enum": ["ai_draft", "ai_reviewed", "human_reviewed"] },
    "taxon_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gbif": { "type": ["integer", "string", "null"] },
        "ncbi": { "type": ["integer", "string", "null"] }
      }
    }
  },
  "$defs": {
    "lineage_item": {
      "type": "object",
      "required": ["rank", "name"],
      "additionalProperties": false,
      "properties": {
        "rank": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "required": ["url", "author", "license", "source_url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "minLength": 1 },
        "alt_th": { "type": "string" },
        "alt_en": { "type": "string" },
        "caption_th": { "type": "string" },
        "caption_en": { "type": "string" }
      }
    }
  }
}
