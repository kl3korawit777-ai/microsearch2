{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "organism.schema.json",
  "title": "organism: หนึ่งชนิดใน data/organisms/<group>.json",
  "description": "ส่วนที่ขึ้นกับ groups.json (ค่าใน traits, tags, ลำดับขั้นใน lineage) ตรวจใน scripts/microsearch.py ไม่ได้อยู่ใน schema นี้",
  "type": "object",
  "required": [
    "id",
    "group",
    "scientific_name",
    "name_th",
    "name_en",
    "reading_th",
    "lineage",
    "level",
    "tags",
    "summary_th",
    "summary_en",
    "traits",
    "traits_text_th",
    "traits_text_en",
    "images",
    "review",
    "taxon_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "scientific_name": {
      "type": "string",
      "minLength": 1
    },
    "name_th": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "reading_th": {
      "type": "string"
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lineage_item"
      }
    },
    "level": {
      "type": "string",
      "enum": [
        "hs",
        "uni"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary_th": {
      "type": "string"
    },
    "summary_en": {
      "type": "string"
    },
    "traits": {
      "type": "object",
      "description": "ค่าเลือกเป็นสตริง (คีย์ใน groups.json > trait_values) ส่วนลักษณะที่เป็นช่วงตัวเลขเป็น {min, max, unit} ตรวจใน validate",
      "additionalProperties": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "traits_text_th": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "traits_text_en": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "illustration": {
      "type": "string"
    },
    "extra_th": {
      "$ref": "#/$defs/extra"
    },
    "extra_en": {
      "$ref": "#/$defs/extra"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "review": {
      "type": "string",
      "enum": [
        "ai_draft",
        "ai_reviewed",
        "human_reviewed"
      ]
    },
    "taxon_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gbif": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "ncbi": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "authority": {
      "type": "string",
      "description": "ผู้ตั้งชื่อและปี เช่น (Gibbons, 1974) หรือ Escherich, 1885"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "ชื่อพ้องที่ยังพบในตำรา"
    },
    "accepted_name": {
      "type": "string",
      "minLength": 1,
      "description": "ชื่อที่ยอมรับปัจจุบัน ใส่เมื่อต่างจากชื่อตำราใน scientific_name"
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "iucn": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "category",
        "url",
        "assessed"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "EX",
            "EW",
            "CR",
            "EN",
            "VU",
            "NT",
            "LC",
            "DD",
            "NE"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "assessed": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        }
      }
    }
  },
  "$defs": {
    "lineage_item": {
      "type": "object",
      "required": [
        "rank",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "rank": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "url",
        "author",
        "license",
        "source_url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "alt_th": {
          "type": "string"
        },
        "alt_en": {
          "type": "string"
        },
        "caption_th": {
          "type": "string"
        },
        "caption_en": {
          "type": "string"
        }
      }
    },
    "pairs": {
      "type": "array",
      "description": "แถวของตาราง: [ป้าย, ข้อความ]",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "ref": {
      "type": "object",
      "required": [
        "title",
        "url",
        "accessed"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lede": {
          "type": "string",
          "description": "ส่วน 2 รู้จักใน 30 วินาที"
        },
        "traitsExtra": {
          "$ref": "#/$defs/pairs",
          "description": "ส่วน 3 แถวลักษณะเพิ่ม"
        },
        "life": {
          "$ref": "#/$defs/pairs",
          "description": "ส่วน 4 การดำรงชีวิต"
        },
        "lifecycle": {
          "$ref": "#/$defs/pairs",
          "description": "ส่วน 5 การสืบพันธุ์และวงชีวิต"
        },
        "why": {
          "$ref": "#/$defs/pairs",
          "description": "ส่วน 6 ความสำคัญ"
        },
        "name": {
          "$ref": "#/$defs/pairs",
          "description": "ส่วน 7 ชื่อนี้มาจากไหน"
        },
        "asideTitle": {
          "type": "string"
        },
        "aside": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ส่วน 7 เกร็ด"
        },
        "disease": {
          "type": "object",
          "additionalProperties": false,
          "description": "เชื้อก่อโรคและปรสิต ไม่มีชื่อสูตรยาหรือขนาดยา",
          "properties": {
            "name": {
              "type": "string"
            },
            "symptoms": {
              "type": "string"
            },
            "transmission": {
              "type": "string"
            },
            "prevention": {
              "type": "string"
            },
            "drugs": {
              "type": "string",
              "description": "กลุ่มยาแบบกว้างเท่านั้น"
            }
          }
        },
        "warning": {
          "type": "object",
          "additionalProperties": false,
          "description": "เห็ดพิษและสัตว์มีพิษ",
          "properties": {
            "text": {
              "type": "string"
            },
            "myths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
