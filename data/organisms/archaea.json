    "extra_th": {
      "lede": "อาร์เคียที่อยู่ได้ในน้ำเกลือเข้มข้นจนสิ่งมีชีวิตส่วนใหญ่ตาย พบในบ่อตากเกลือและทะเลสาบน้ำเค็มจัด เซลล์มีรงควัตถุสีแดงและโปรตีนที่ใช้พลังงานแสงได้ จึงเป็นทั้งตัวทำให้นาเกลือเป็นสีชมพูและเป็นสิ่งมีชีวิตต้นแบบในงานวิจัย",
      "traitsExtra": [
        [
          "ผนังเซลล์",
          "ไม่มีเพปทิโดไกลแคน มีชั้นไกลโคโปรตีนที่เรียกว่า S-layer ย้อมแกรมติดสีแบบแกรมลบ"
        ],
        [
          "ความเค็มที่เหมาะ",
          "NaCl ราว 4 โมลาร์ เข้มข้นกว่าน้ำทะเลประมาณ 7 เท่า"
        ]
      ],
      "why": [
        [
          "นิเวศ",
          "เป็นสาเหตุหนึ่งที่ทำให้บ่อตากเกลือมีสีชมพูถึงแดง จากรงควัตถุแคโรทีนอยด์ชื่อแบคทีริโอรูเบอริน"
        ],
        [
          "วิทยาศาสตร์",
          "แบคทีริโอโรดอปซินเป็นปั๊มโปรตอนที่ขับเคลื่อนด้วยแสง และเป็นโปรตีนเยื่อหุ้มเซลล์ที่ถูกศึกษาโครงสร้างมากที่สุดชนิดหนึ่ง"
        ],
        [
          "อาหาร",
          "ทำให้ปลาเค็มและหนังสัตว์ที่หมักเกลือเสียและเป็นสีชมพูได้"
        ],
        [
          "สุขภาพ",
          "ไม่ใช่เชื้อก่อโรคในคน"
        ]
      ],
      "name": [
        [
          "Halobacterium",
          "มาจากภาษากรีก hals แปลว่าเกลือ รวมกับ bacterium"
        ],
        [
          "salinarum",
          "ภาษาละติน แปลว่า ของนาเกลือ"
        ],
        [
          "ชื่อพ้อง",
          "Halobacterium halobium, Halobacterium cutirubrum"
        ]
      ],
      "asideTitle": "ชื่อมีคำว่า bacterium แต่ไม่ใช่แบคทีเรีย",
      "aside": [
        "ผนังเซลล์ไม่มีเพปทิโดไกลแคน ใช้ชั้นไกลโคโปรตีน S-layer แทน",
        "ลิพิดของเยื่อหุ้มเซลล์ต่อกันด้วยพันธะอีเทอร์ ส่วนแบคทีเรียใช้พันธะเอสเทอร์",
        "RNA polymerase และกลไกการถอดรหัสคล้ายของยูแคริโอตมากกว่าของแบคทีเรีย",
        "ชื่อสกุลตั้งไว้ก่อนที่นักวิทยาศาสตร์จะแยกอาร์เคียออกเป็นอีกโดเมน"
      ]
    },
    "extra_en": {
      "lede": "An archaeon that survives in brine strong enough to kill most life. It lives in salt evaporation ponds and very salty lakes. Its red pigments and light-driven proteins make salt ponds pink and make it a model organism in research.",
      "traitsExtra": [
        [
          "Cell wall",
          "No peptidoglycan; a glycoprotein S-layer instead. Stains Gram-negative."
        ],
        [
          "Preferred salinity",
          "About 4 molar NaCl, roughly 7 times saltier than seawater"
        ]
      ],
      "why": [
        [
          "Ecology",
          "One reason salt ponds turn pink to red, from the carotenoid bacterioruberin"
        ],
        [
          "Research",
          "Bacteriorhodopsin is a light-driven proton pump and one of the most studied membrane proteins"
        ],
        [
          "Food",
          "Can spoil salted fish and hides, turning them pink"
        ],
        [
          "Health",
          "Not a human pathogen"
        ]
      ],
      "name": [
        [
          "Halobacterium",
          "From Greek hals, salt, plus bacterium"
        ],
        [
          "salinarum",
          "Latin for \"of the salt works\""
        ],
        [
          "Synonyms",
          "Halobacterium halobium, Halobacterium cutirubrum"
        ]
      ],
      "asideTitle": "Called a bacterium, but not a bacterium",
      "aside": [
        "No peptidoglycan in the cell wall; an S-layer of glycoprotein instead",
        "Membrane lipids are joined by ether bonds, while bacteria use ester bonds",
        "RNA polymerase and transcription look more like those of eukaryotes than of bacteria",
        "The genus was named before scientists split archaea off as a separate domain"
      ]
    }
